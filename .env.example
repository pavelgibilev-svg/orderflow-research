# Live recorder configuration. Copy to `.env` and edit.
# This is PUBLIC market-data only — no API key, no trading.

EXCHANGE=binance-futures
SYMBOLS=BTCUSDT
DEPTH_STREAM_SPEED=100ms
SNAPSHOT_INTERVAL_MS=1000

CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=orderflow
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

RAW_SPOOL_DIR=./data/live-spool
LOG_LEVEL=info

# Optional: override Binance Futures REST/WS hosts for testing.
BINANCE_REST_BASE=https://fapi.binance.com
BINANCE_WS_BASE=wss://fstream.binance.com
